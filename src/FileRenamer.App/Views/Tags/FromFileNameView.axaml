<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tags="using:FileRenamer.App.ViewModels.Tags"
             xmlns:loc="using:FileRenamer.App.Localization"
             x:Class="FileRenamer.App.Views.Tags.FromFileNameView"
             x:DataType="tags:FromFileNameEditorViewModel">
  <StackPanel Spacing="10">
    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="9" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Classes="fieldLabel" Text="{loc:T FromName.Template}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="TemplateBox" Width="340" Text="{Binding Template}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
        <ComboBox ItemsSource="{Binding Presets}" PlaceholderText="{loc:T FromName.Preset}" MinWidth="200" SelectionChanged="OnPresetSelected" />
      </StackPanel>

      <TextBlock Grid.Row="1" Classes="fieldLabel" Text="{loc:T FromName.Placeholders}" />
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
        <Grid ColumnDefinitions="100,*">
          <TextBlock Classes="hint" Text="{loc:T FromName.GroupAudio}" Margin="0,3,0,0" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding AudioPlaceholders}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Content="{Binding}" Click="OnPlaceholderClick" Padding="8,1" Margin="0,0,4,4" CornerRadius="10"
                        FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        <Grid ColumnDefinitions="100,*">
          <TextBlock Classes="hint" Text="{loc:T FromName.GroupOther}" Margin="0,3,0,0" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding OtherPlaceholders}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Content="{Binding}" Click="OnPlaceholderClick" Padding="8,1" Margin="0,0,4,4" CornerRadius="10"
                        FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12"
                        ToolTip.Tip="{loc:T FromName.SkipTip}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        <TextBlock Classes="hint" Text="{loc:T FromName.FolderHint}" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Grid.Row="2" Classes="fieldLabel" Text="{loc:T TagEditor.Scope}" />
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
        <RadioButton Classes="segment" GroupName="fromNameScope" Content="{loc:T TagEditor.ScopeSelected}"
                     IsChecked="{Binding Scope, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static tags:TagScope.Selected}}" />
        <RadioButton Classes="segment" GroupName="fromNameScope" Content="{loc:T TagEditor.ScopeAll}"
                     IsChecked="{Binding Scope, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static tags:TagScope.AllAudio}}" />
      </StackPanel>

      <TextBlock Grid.Row="3" Classes="fieldLabel" Text="{loc:T FromName.Spaces}" />
      <CheckBox Grid.Row="3" Grid.Column="1" Content="{loc:T FromName.Underscore}" IsChecked="{Binding UnderscoreAsSpace}" />

      <TextBlock Grid.Row="4" Classes="fieldLabel" Text="{loc:T TagEditor.Example}" IsVisible="{Binding Example, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4" IsVisible="{Binding Example, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Border Classes="example"><TextBlock Text="{Binding Example}" /></Border>
        <TextBlock Classes="hint" Text="{loc:T FromName.NoMatchHint}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    <TextBlock Classes="error" Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" />
    <Button Classes="accent" Content="{loc:T TagEditor.Stage}" Command="{Binding StageCommand}" />
  </StackPanel>
</UserControl>
