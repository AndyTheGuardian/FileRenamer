<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FileRenamer.App.Localization"
             xmlns:vm="using:FileRenamer.App.ViewModels"
             x:Class="FileRenamer.App.Views.AccentPickerView"
             x:DataType="vm:AccentColorViewModel"
             Width="320">
  <UserControl.Styles>
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Margin" Value="0,8,0,6" />
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.swatch.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="Button.swatch Ellipse">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Stroke" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <!-- Schmales Zahlenfeld (E104): Fluent gibt dem inneren Textfeld 64 px Mindestbreite vor; ohne Aufhebung
         würde der Rahmen rechts abgeschnitten. Höhe bleibt die der übrigen Textfelder. -->
    <Style Selector="NumericUpDown.compact /template/ TextBox">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="8,6,6,5" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate x:DataType="vm:SwatchViewModel">
      <Panel>
        <Button Classes="swatch" Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding ToolTip}"
                Command="{Binding $parent[UserControl].((vm:AccentColorViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
          <Ellipse Fill="{Binding Hex, Converter={StaticResource HexToBrush}}" />
        </Button>
        <Button Content="✕" IsVisible="{Binding IsCustom}" ToolTip.Tip="{loc:T Accent.Remove}" FontSize="9" Padding="0"
                Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Command="{Binding $parent[UserControl].((vm:AccentColorViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
      </Panel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <StackPanel Margin="4">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="groupTitle" Text="{loc:T Accent.Pastel}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" ToolTip.Tip="{loc:T Accent.SaturationTip}">
        <Slider Minimum="10" Maximum="90" Width="90" Value="{Binding SliderValue}" VerticalAlignment="Center" />
        <NumericUpDown Classes="compact" Value="{Binding SaturationInput}" Minimum="10" Maximum="90" Increment="1" FormatString="0"
                       ShowButtonSpinner="False" Width="52" VerticalAlignment="Center" VerticalContentAlignment="Center" />
        <TextBlock Text="%" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SaturationByteText}" Classes="hint" VerticalAlignment="Center" Width="40" />
      </StackPanel>
    </Grid>
    <ItemsControl ItemsSource="{Binding Pastel}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>

    <TextBlock Classes="groupTitle" Text="{loc:T Accent.Strong}" />
    <ItemsControl ItemsSource="{Binding Strong}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>

    <TextBlock Classes="groupTitle" Text="{loc:T Accent.Neutral}" />
    <ItemsControl ItemsSource="{Binding Neutral}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>

    <TextBlock Classes="groupTitle" Text="{loc:T Accent.Custom}" />
    <ItemsControl ItemsSource="{Binding Custom}" IsVisible="{Binding HasCustomColors}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
    <TextBlock Classes="hint" Text="{loc:T Accent.NoCustom}" IsVisible="{Binding !HasCustomColors}" />

    <TextBlock Classes="groupTitle" Text="{loc:T Accent.OwnColor}" />
    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBox Text="{Binding HexInput}" Width="100" MaxLength="7" PlaceholderText="#25A0C3" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" />
      <Button Content="{loc:T Accent.Apply}" Command="{Binding ApplyHexCommand}" IsDefault="True" />
    </StackPanel>
    <TextBlock Classes="hint" Text="{loc:T Accent.HexHint}" IsVisible="{Binding !HasHexError}" Margin="0,4,0,0" />
    <TextBlock Classes="error" Text="{Binding HexError}" IsVisible="{Binding HasHexError}" Margin="0,4,0,0" />

    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <Button Command="{Binding ResetCommand}" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{loc:T Accent.DefaultTip}">
        <TextBlock Text="{loc:T Accent.Default}" TextDecorations="Underline" />
      </Button>
      <TextBlock Grid.Column="1" Classes="hint" Text="{loc:T Accent.Saved}" VerticalAlignment="Center" />
    </Grid>
  </StackPanel>
</UserControl>
