<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileRenamer.App.ViewModels"
        xmlns:ed="using:FileRenamer.App.ViewModels.Editors"
        xmlns:views="using:FileRenamer.App.Views.Editors"
        xmlns:views1="using:FileRenamer.App.Views"
        xmlns:controls="using:FileRenamer.App.Controls"
        xmlns:profiles="using:FileRenamer.Core.Profiles"
        xmlns:preview="using:FileRenamer.Core.Preview"
        xmlns:changes="using:FileRenamer.Core.Tagging.Changes"
        xmlns:tagviews="using:FileRenamer.App.Views.Tags"
        xmlns:loc="using:FileRenamer.App.Localization"
        x:Class="FileRenamer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FileRenamer"
        Icon="avares://FileRenamer/Assets/app.png"
        Width="1240" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        DragDrop.AllowDrop="True">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding ShowRenameAreaCommand}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding ShowTagAreaCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding Tags.SaveCommand}" />
  </Window.KeyBindings>

  <Window.DataTemplates>
    <DataTemplate DataType="ed:ReplaceTextEditorViewModel"><views:ReplaceTextEditorView /></DataTemplate>
    <DataTemplate DataType="ed:AppendDateEditorViewModel"><views:AppendDateEditorView /></DataTemplate>
    <DataTemplate DataType="ed:AppendCounterEditorViewModel"><views:AppendCounterEditorView /></DataTemplate>
    <DataTemplate DataType="ed:ShiftDigitRangeEditorViewModel"><views:ShiftDigitRangeEditorView /></DataTemplate>
    <DataTemplate DataType="ed:InsertTextEditorViewModel"><views:InsertTextEditorView /></DataTemplate>
    <DataTemplate DataType="ed:ChangeCaseEditorViewModel"><views:ChangeCaseEditorView /></DataTemplate>
    <DataTemplate DataType="ed:CleanCharactersEditorViewModel"><views:CleanCharactersEditorView /></DataTemplate>
    <DataTemplate DataType="ed:RemoveRangeEditorViewModel"><views:RemoveRangeEditorView /></DataTemplate>
    <DataTemplate DataType="ed:TemplateEditorViewModel"><views:TemplateEditorView /></DataTemplate>
    <DataTemplate DataType="ed:InsertFolderEditorViewModel"><views:InsertFolderEditorView /></DataTemplate>
    <DataTemplate DataType="ed:ChangeExtensionEditorViewModel"><views:ChangeExtensionEditorView /></DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Border.pane">
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector=":is(TextBlock).mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
    </Style>
    <Style Selector="Border.previewRow.conflict">
      <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
    </Style>
    <Style Selector="Border.previewRow.unselected :is(TextBlock).name">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- Rahmenfarbe nur per Style, damit .error sie überschreiben kann -->
    <Style Selector="Border.chainItem">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.chainItem.error">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <!-- Gezogener Ketteneintrag bleibt blass an seinem Platz, bis er abgelegt wird (wie Mockup v10, E102) -->
    <Style Selector="ListBoxItem.dragging">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="TextBlock.strike">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.preview ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- Zeilenmarkierung zum Kopieren, unabhängig von der Checkbox (Dateiauswahl) -->
    <Style Selector="ListBox.preview ListBoxItem" x:DataType="vm:PreviewRowViewModel">
      <Setter Property="IsSelected" Value="{Binding IsMarked, Mode=TwoWay}" />
    </Style>
    <Style Selector="ListBox.preview ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.preview ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <!-- Eigenes Kontextmenü der Liste statt des englischen Standardmenüs markierbarer Texte -->
    <!-- Rahmen ohne Layoutverschiebung (Padding um die Rahmenstärke verringert); sichtbar nur bei markierten
         Konfliktzeilen, deren roter Hintergrund die Markierungsfarbe sonst verdecken würde -->
    <Style Selector="Border.previewRow">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="6,1" />
    </Style>
    <Style Selector="ListBox.preview ListBoxItem:selected Border.previewRow.conflict">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="Border.previewRow SelectableTextBlock">
      <Setter Property="ContextFlyout" Value="{x:Null}" />
    </Style>
  </Window.Styles>

  <!-- Äußeres Panel: Inhalt plus Ebene für das Ziehen von Ketteneinträgen (E102) -->
  <Panel>
    <DockPanel>
      <!-- Menü -->
      <Menu DockPanel.Dock="Top">
        <MenuItem Header="{loc:T Menu.File}">
          <MenuItem Header="{loc:T Menu.AddFiles}" Command="{Binding AddFilesCommand}" InputGesture="Ctrl+O" />
          <MenuItem Header="{loc:T Menu.AddFolder}" Command="{Binding AddFolderCommand}" InputGesture="Ctrl+Shift+O" />
          <Separator />
          <MenuItem Header="{loc:T Menu.ClearList}" Command="{Binding ClearFilesCommand}" />
          <Separator />
          <!-- Einstellungen (E155, E156); FileRenamer hat kein Menü „Bearbeiten“ (F77) -->
          <MenuItem Header="{loc:T Menu.Settings}" Command="{Binding OpenSettingsCommand}" />
          <Separator />
          <MenuItem Header="{loc:T Menu.Exit}" Click="OnExitClick" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.Profiles}">
          <MenuItem Header="{loc:T Menu.LoadProfile}" Click="OnLoadProfileClick" />
          <MenuItem Header="{loc:T Menu.SaveProfile}" Command="{Binding SaveProfileCommand}" InputGesture="Ctrl+S" />
          <MenuItem Header="{loc:T Menu.ResetProfile}" Command="{Binding ResetProfileCommand}" />
          <Separator />
          <MenuItem Header="{loc:T Menu.DeleteProfile}" Command="{Binding DeleteProfileCommand}" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.Tags}">
          <MenuItem Header="{loc:T Menu.TagsSave}" Command="{Binding Tags.SaveCommand}" InputGesture="Ctrl+Shift+S" />
          <MenuItem Header="{loc:T Menu.TagsDiscard}" Command="{Binding Tags.DiscardCommand}" />
          <Separator />
          <MenuItem Header="{loc:T Menu.TagsCover}" Command="{Binding ShowTagFunctionCommand}" CommandParameter="{x:Static changes:TagFunction.Cover}" />
          <MenuItem Header="{loc:T Menu.TagsLyrics}" Command="{Binding ShowTagFunctionCommand}" CommandParameter="{x:Static changes:TagFunction.Lyrics}" />
        </MenuItem>
        <MenuItem Header="{loc:T Menu.View}">
          <MenuItem Header="{loc:T Menu.AreaRename}" ToggleType="Radio" Command="{Binding ShowRenameAreaCommand}" InputGesture="Ctrl+D1"
                    IsChecked="{Binding IsRenameArea, Mode=OneWay}" />
          <MenuItem Header="{loc:T Menu.AreaTags}" ToggleType="Radio" Command="{Binding ShowTagAreaCommand}" InputGesture="Ctrl+D2"
                    IsChecked="{Binding IsTagArea, Mode=OneWay}" />
          <Separator />
          <MenuItem Header="{loc:T Menu.ThemeSystem}" ToggleType="Radio" Command="{Binding SetThemeCommand}"
                    CommandParameter="{x:Static profiles:ThemePreference.System}"
                    IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.System}}" />
          <MenuItem Header="{loc:T Menu.ThemeLight}" ToggleType="Radio" Command="{Binding SetThemeCommand}"
                    CommandParameter="{x:Static profiles:ThemePreference.Light}"
                    IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.Light}}" />
          <MenuItem Header="{loc:T Menu.ThemeDark}" ToggleType="Radio" Command="{Binding SetThemeCommand}"
                    CommandParameter="{x:Static profiles:ThemePreference.Dark}"
                    IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.Dark}}" />
          <Separator />
          <MenuItem Header="{loc:T Menu.Accent}" Command="{Binding OpenSettingsCommand}" />
          <Separator />
          <!-- Sprache (E92): wirkt sofort, das Fenster wird neu aufgebaut -->
          <MenuItem Header="{loc:T Menu.Language}">
            <MenuItem Header="{loc:T Menu.LanguageSystem}" ToggleType="Radio" Command="{Binding SetLanguageCommand}"
                      CommandParameter="{x:Static profiles:LanguagePreference.System}"
                      IsChecked="{Binding Language, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:LanguagePreference.System}}" />
            <MenuItem Header="{loc:T Menu.LanguageGerman}" ToggleType="Radio" Command="{Binding SetLanguageCommand}"
                      CommandParameter="{x:Static profiles:LanguagePreference.German}"
                      IsChecked="{Binding Language, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:LanguagePreference.German}}" />
            <MenuItem Header="{loc:T Menu.LanguageEnglish}" ToggleType="Radio" Command="{Binding SetLanguageCommand}"
                      CommandParameter="{x:Static profiles:LanguagePreference.English}"
                      IsChecked="{Binding Language, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:LanguagePreference.English}}" />
          </MenuItem>
        </MenuItem>
      </Menu>

      <!-- Toolbar: Profil und Theme -->
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,1" Padding="12,8">
        <Grid x:Name="Toolbar" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
          <TextBlock Text="{loc:T Toolbar.Profile}" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding IsRenameArea}"
                     Classes="toolbarLabel" />
          <ComboBox Grid.Column="1" x:Name="ProfileComboBox" MinWidth="240" IsEditable="True" IsVisible="{Binding IsRenameArea}"
                    PlaceholderText="{loc:T Toolbar.ProfilePlaceholder}"
                    ToolTip.Tip="{loc:T Toolbar.ProfileTip}"
                    ItemsSource="{Binding ProfileNames}" Text="{Binding ProfileNameInput}"
                    SelectedItem="{Binding CurrentProfileName, Mode=OneWay}" DropDownClosed="OnProfileDropDownClosed" />
          <Button Grid.Column="2" Content="{loc:T Toolbar.Save}" Margin="8,0,0,0" Command="{Binding SaveProfileCommand}" IsVisible="{Binding IsRenameArea}"
                  ToolTip.Tip="{loc:T Toolbar.SaveTip}" />
          <Button Grid.Column="3" Content="{loc:T Toolbar.Reset}" Margin="8,0,0,0" Command="{Binding ResetProfileCommand}" IsVisible="{Binding IsRenameArea}"
                  ToolTip.Tip="{loc:T Toolbar.ResetTip}" />
          <StackPanel Grid.Column="5" Orientation="Horizontal">
            <!-- Bereich: Umbenennen / Tags, Icons mit Tooltip (E119); Beschriftung nur bei genug Platz (E147, AreaLabelFitter);
                 eigenes Panel für die Randrundung -->
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
              <RadioButton Classes="segment" GroupName="area" ToolTip.Tip="{loc:T Toolbar.AreaRename}" IsChecked="{Binding IsRenameArea}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconRename}" Width="16" Height="16" />
                  <TextBlock x:Name="AreaRenameLabel" Text="{loc:T Toolbar.AreaRenameLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
              <RadioButton Classes="segment" GroupName="area" ToolTip.Tip="{loc:T Toolbar.AreaTags}" IsChecked="{Binding IsTagArea}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconTags}" Width="16" Height="16" />
                  <TextBlock x:Name="AreaTagsLabel" Text="{loc:T Toolbar.AreaTagsLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
            </StackPanel>
            <!-- Eigenes Panel, damit die Randrundung der Segmente greift -->
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment" GroupName="theme" ToolTip.Tip="{loc:T Toolbar.ThemeSystem}"
                           IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.System}}">
                <PathIcon Data="{StaticResource IconSystem}" Width="16" Height="16" />
              </RadioButton>
              <RadioButton Classes="segment" GroupName="theme" ToolTip.Tip="{loc:T Toolbar.ThemeLight}"
                           IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.Light}}">
                <PathIcon Data="{StaticResource IconLight}" Width="16" Height="16" />
              </RadioButton>
              <RadioButton Classes="segment" GroupName="theme" ToolTip.Tip="{loc:T Toolbar.ThemeDark}"
                           IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.Dark}}">
                <PathIcon Data="{StaticResource IconDark}" Width="16" Height="16" />
              </RadioButton>
            </StackPanel>
            <!-- Zahnrad: Einstellungen mit Design, Sprache, Farben und Farbprofilen (E155, E156) -->
            <Button x:Name="SettingsButton" Margin="10,0,0,0" Width="{StaticResource ControlHeight}" Height="{StaticResource ControlHeight}" Padding="0" VerticalAlignment="Center"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="{loc:T Toolbar.Settings}" Command="{Binding OpenSettingsCommand}">
              <PathIcon Data="{StaticResource IconSettings}" Width="18" Height="18" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Panel>
      <!-- Bereich „Tags“ (E114) -->
      <tagviews:TagAreaView DataContext="{Binding Tags}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsTagArea}" />

      <!-- Bereich „Umbenennen“ -->
      <DockPanel IsVisible="{Binding IsRenameArea}">
      <!-- Fußzeile: Status und Aktionen -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
          <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding BlockingText}" Margin="6,0,0,0" FontWeight="SemiBold"
                     Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
          <Button Grid.Column="3" Content="{loc:T Footer.Undo}" Command="{Binding UndoRenameCommand}" Margin="0,0,8,0"
                  ToolTip.Tip="{loc:T Footer.UndoTip}" />
          <Button Grid.Column="4" Content="{loc:T Footer.Discard}" Command="{Binding DiscardCommand}" Margin="0,0,8,0"
                  ToolTip.Tip="{loc:T Footer.DiscardTip}" />
          <Button Grid.Column="5" Content="{loc:T Footer.Rename}" Classes="accent" Command="{Binding RenameCommand}" />
        </Grid>
      </Border>

      <!-- Zweigeteilter Inhalt -->
      <Grid RowDefinitions="*,Auto,*">
        <!-- Obere Hälfte: Einstellungen -->
        <Grid ColumnDefinitions="270,*">
          <Border Classes="pane" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="{loc:T Pane.Methods}" />
              <!-- Gruppierte Verfahrensliste (E72); Überschriften sind nicht auswählbar -->
              <ListBox Classes="plain ruleList" ItemsSource="{Binding RuleEntries}" SelectedItem="{Binding SelectedRuleKind}">
                <ListBox.Styles>
                  <Style Selector="ListBox.ruleList ListBoxItem" x:DataType="vm:RuleListEntry">
                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                  </Style>
                </ListBox.Styles>
                <ListBox.DataTemplates>
                  <DataTemplate DataType="vm:RuleGroupHeader">
                    <TextBlock Classes="paneTitle" Text="{Binding Title}" Margin="8,8,0,0" FontSize="10.5" />
                  </DataTemplate>
                  <DataTemplate DataType="vm:RuleKindItem">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,5">
                      <Border Classes="ruleBar" controls:RuleColor.Kind="{Binding Kind}" />
                      <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.DataTemplates>
              </ListBox>
            </DockPanel>
          </Border>

          <ScrollViewer Grid.Column="1">
            <StackPanel Margin="16,12" Spacing="12" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="ruleBar" controls:RuleColor.Kind="{Binding Editor.Kind}" MinHeight="20" />
                <TextBlock Text="{Binding Editor.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <ContentControl Content="{Binding Editor}" />
              <Grid ColumnDefinitions="190,*" IsVisible="{Binding Editor.HasExample}">
                <TextBlock Text="{loc:T Editor.Example}" VerticalAlignment="Center" />
                <Border Grid.Column="1" HorizontalAlignment="Left" Padding="10,5" CornerRadius="4" BorderThickness="1"
                        Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                  <TextBlock Classes="mono" Text="{Binding Editor.Example}" />
                </Border>
              </Grid>
              <TextBlock Classes="error" Text="{Binding Editor.ValidationMessage}" IsVisible="{Binding Editor.HasValidationMessage}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="{loc:T Editor.AddToChain}" Command="{Binding AddToChainCommand}" />
                <Button Content="{loc:T Editor.Reset}" Command="{Binding ResetEditorCommand}" />
              </StackPanel>
              <TextBlock Classes="hint" IsVisible="{Binding IsEditingChainItem}"
                         Text="{loc:T Editor.EditingHint}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" Background="{DynamicResource AppBorderBrush}" />

        <!-- Untere Hälfte: Kette und Vorschau -->
        <Grid Grid.Row="2" ColumnDefinitions="270,*">
          <Border Classes="pane" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="{loc:T Pane.Applied}" />
              <TextBlock DockPanel.Dock="Top" Classes="hint" Text="{loc:T Pane.ChainRoot}" Margin="2,0,0,6" />
              <ListBox x:Name="ChainList" Classes="plain" ItemsSource="{Binding Chain}" SelectedItem="{Binding SelectedChainItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChainItemViewModel">
                    <Border Classes="chainItem" Classes.error="{Binding HasError}" BorderThickness="1"
                            CornerRadius="4" Padding="4,4" ToolTip.Tip="{Binding Error}">
                      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <TextBlock Classes="dragHandle" Text="⋮⋮" Cursor="SizeNorthSouth" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" Padding="4,0" ToolTip.Tip="{loc:T Chain.DragTip}" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" MinWidth="0" Margin="2,0,4,0" ToolTip.Tip="{loc:T Chain.EnableTip}" />
                        <Border Grid.Column="2" Classes="ruleBar" controls:RuleColor.Kind="{Binding Kind}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="3" Text="{Binding DisplayName}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Classes.strike="{Binding !IsEnabled}" />
                        <Button Grid.Column="4" Content="✕" Padding="6,2" Background="Transparent" BorderThickness="0" ToolTip.Tip="{loc:T Chain.RemoveTip}"
                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).RemoveChainItemCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Classes="pane">
            <DockPanel>
              <!-- „Liste leeren“ über der Liste; der Ablagehinweis steht in der leeren Liste (E152) -->
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                <TextBlock Classes="paneTitle" Text="{loc:T Pane.Preview}" VerticalAlignment="Center" Margin="0" />
                <CheckBox Grid.Column="1" Content="{loc:T Pane.IgnoreExtension}" IsChecked="{Binding IgnoreExtension}" Margin="0,0,12,0" />
                <Button Grid.Column="2" Classes="paneAction" Content="{loc:T Pane.ClearList}" Command="{Binding ClearFilesCommand}" />
              </Grid>
              <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                <DockPanel controls:ColumnRowPanel.Layout="{Binding RenameColumns}">
                  <Border DockPanel.Dock="Top" Classes="listHeader">
                    <!-- Spaltenköpfe: Kante ziehen = Breite, Kopf ziehen = verschieben, Rechtsklick = Menü (E146);
                         beim horizontalen Scrollen mitgeschoben (E151) -->
                    <Grid x:Name="RenameHeader" ColumnDefinitions="32,28,*">
                      <CheckBox Classes="fileCheck" IsChecked="{Binding AreAllSelected}" ToolTip.Tip="{loc:T Pane.SelectAllTip}" />
                      <controls:ColumnHeaderPanel Grid.Column="2">
                        <TextBlock controls:ColumnRowPanel.Key="original" Classes="paneTitle" Margin="0,0,12,0" Text="{loc:T Pane.CurrentName}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock controls:ColumnRowPanel.Key="new" Classes="paneTitle" Margin="0,0,12,0" Text="{loc:T Pane.NewName}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </controls:ColumnHeaderPanel>
                    </Grid>
                  </Border>
                  <Panel>
                    <controls:PreviewListBox x:Name="PreviewList" Classes="preview" ItemsSource="{Binding PreviewRows}"
                                             Background="Transparent" SelectionMode="Multiple"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                      <ListBox.ContextMenu>
                        <ContextMenu>
                          <MenuItem x:Name="CopySelectedTextItem" Header="{loc:T Pane.CopySelectedText}" />
                          <Separator IsVisible="{Binding #CopySelectedTextItem.IsVisible}" />
                          <MenuItem Header="{loc:T Pane.CopyOriginalNames}" Command="{Binding CopyNamesCommand}"
                                    CommandParameter="{x:Static preview:NameColumns.Original}" />
                          <MenuItem Header="{loc:T Pane.CopyNewNames}" Command="{Binding CopyNamesCommand}"
                                    CommandParameter="{x:Static preview:NameColumns.New}" InputGesture="Ctrl+C" />
                          <MenuItem Header="{loc:T Pane.CopyBothNames}" Command="{Binding CopyNamesCommand}"
                                    CommandParameter="{x:Static preview:NameColumns.Both}" />
                        </ContextMenu>
                      </ListBox.ContextMenu>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PreviewRowViewModel">
                          <Border Classes="previewRow" Classes.conflict="{Binding HasConflict}" Classes.unselected="{Binding !IsSelected}">
                            <Grid ColumnDefinitions="32,28,*">
                              <CheckBox Classes="fileCheck" IsChecked="{Binding IsSelected}" ToolTip.Tip="{loc:T Pane.SelectFileTip}" />
                              <TextBlock Grid.Column="1" Text="⚠" Foreground="{DynamicResource WarnBrush}" IsVisible="{Binding HasHint}"
                                         ToolTip.Tip="{Binding IssueText}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="⛔" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasConflict}"
                                         ToolTip.Tip="{Binding IssueText}" VerticalAlignment="Center" />
                              <!-- Spaltenmodell ausdrücklich: geerbte Werte erreichen die Listenzeilen nicht -->
                              <controls:ColumnRowPanel Grid.Column="2" Layout="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).RenameColumns}">
                                <SelectableTextBlock controls:ColumnRowPanel.Key="original" Classes="mono name" Text="{Binding OriginalName}"
                                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <controls:HighlightedTextBlock controls:ColumnRowPanel.Key="new" Classes="mono name" Spans="{Binding Spans}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                              </controls:ColumnRowPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </controls:PreviewListBox>
                    <TextBlock Classes="emptyHint" Text="{loc:T Pane.DropHint}" IsVisible="{Binding !HasFiles}" />
                  </Panel>
                </DockPanel>
              </Border>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
      </DockPanel>
      </Panel>
    </DockPanel>

    <!-- Ziehebene: Abbild des gezogenen Eintrags folgt dem Mauszeiger, die Linie zeigt die Einfügestelle (E102) -->
    <Canvas x:Name="DragLayer" IsHitTestVisible="False">
      <Border x:Name="DropLine" Height="2" CornerRadius="1" Background="{DynamicResource SystemAccentColor}" IsVisible="False" />
      <Border x:Name="DragGhost" IsVisible="False" x:DataType="vm:ChainItemViewModel" Opacity="0.92"
              Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource SystemAccentColor}"
              BorderThickness="1" CornerRadius="4" Padding="4,4" BoxShadow="0 4 12 0 #40000000">
        <Grid ColumnDefinitions="Auto,Auto,*" MinHeight="28">
          <TextBlock Text="⋮⋮" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Padding="4,0" />
          <Border Grid.Column="1" Classes="ruleBar" controls:RuleColor.Kind="{Binding Kind}" Margin="4,0,8,0" />
          <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Canvas>
    <!-- Abdunkelung, solange ein Dialog offen ist (V22, E149); fängt zugleich Klicks ab -->
    <Border x:Name="DialogShade" Background="{DynamicResource DialogShadeBrush}" IsVisible="False" />
  </Panel>
</Window>
