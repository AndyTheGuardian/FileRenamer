<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileRenamer.App.ViewModels"
        xmlns:ed="using:FileRenamer.App.ViewModels.Editors"
        xmlns:views="using:FileRenamer.App.Views.Editors"
        xmlns:controls="using:FileRenamer.App.Controls"
        xmlns:profiles="using:FileRenamer.Core.Profiles"
        x:Class="FileRenamer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="FileRenamer"
        Icon="avares://FileRenamer/Assets/app.png"
        Width="1240" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        DragDrop.AllowDrop="True">

  <Window.DataTemplates>
    <DataTemplate DataType="ed:ReplaceTextEditorViewModel"><views:ReplaceTextEditorView /></DataTemplate>
    <DataTemplate DataType="ed:AppendDateEditorViewModel"><views:AppendDateEditorView /></DataTemplate>
    <DataTemplate DataType="ed:AppendCounterEditorViewModel"><views:AppendCounterEditorView /></DataTemplate>
    <DataTemplate DataType="ed:ShiftDigitRangeEditorViewModel"><views:ShiftDigitRangeEditorView /></DataTemplate>
    <DataTemplate DataType="ed:InsertTextEditorViewModel"><views:InsertTextEditorView /></DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Border.pane">
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
    </Style>
    <Style Selector="Border.previewRow.conflict">
      <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
    </Style>
    <Style Selector="Border.previewRow.unselected TextBlock.name">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.chainItem.error">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.strike">
      <Setter Property="TextDecorations" Value="Strikethrough" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.preview ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Menü -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Datei">
        <MenuItem Header="Dateien _hinzufügen…" Command="{Binding AddFilesCommand}" InputGesture="Ctrl+O" />
        <MenuItem Header="_Ordner hinzufügen…" Command="{Binding AddFolderCommand}" InputGesture="Ctrl+Shift+O" />
        <Separator />
        <MenuItem Header="Liste _leeren" Command="{Binding ClearFilesCommand}" />
        <Separator />
        <MenuItem Header="_Beenden" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Profile">
        <MenuItem Header="Profil _laden…" Click="OnLoadProfileClick" />
        <MenuItem Header="Profil _speichern…" Command="{Binding SaveProfileCommand}" InputGesture="Ctrl+S" />
        <Separator />
        <MenuItem Header="Profil l_öschen…" Command="{Binding DeleteProfileCommand}" />
      </MenuItem>
      <MenuItem Header="_Ansicht">
        <MenuItem Header="Theme: _System" ToggleType="Radio" Command="{Binding SetThemeCommand}"
                  CommandParameter="{x:Static profiles:ThemePreference.System}"
                  IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.System}}" />
        <MenuItem Header="Theme: _Hell" ToggleType="Radio" Command="{Binding SetThemeCommand}"
                  CommandParameter="{x:Static profiles:ThemePreference.Light}"
                  IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.Light}}" />
        <MenuItem Header="Theme: _Dunkel" ToggleType="Radio" Command="{Binding SetThemeCommand}"
                  CommandParameter="{x:Static profiles:ThemePreference.Dark}"
                  IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.Dark}}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: Profil und Theme -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,1" Padding="12,8">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock Text="Profil" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" x:Name="ProfileComboBox" MinWidth="240" IsEditable="True"
                  PlaceholderText="Profilname eingeben oder wählen"
                  ToolTip.Tip="Profil aus der Liste wählen, um es zu laden – oder einen neuen Namen eintippen und speichern"
                  ItemsSource="{Binding ProfileNames}" Text="{Binding ProfileNameInput}"
                  SelectedItem="{Binding CurrentProfileName, Mode=OneWay}" DropDownClosed="OnProfileDropDownClosed" />
        <Button Grid.Column="2" Content="Speichern" Margin="8,0,0,0" Command="{Binding SaveProfileCommand}"
                ToolTip.Tip="Aktuelle Kette als Profil speichern (neuer Name = neues Profil)" />
        <StackPanel Grid.Column="4" Orientation="Horizontal">
          <RadioButton Classes="segment" GroupName="theme" ToolTip.Tip="Theme: System"
                       IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.System}}">
            <PathIcon Data="{StaticResource IconSystem}" Width="16" Height="16" />
          </RadioButton>
          <RadioButton Classes="segment" GroupName="theme" ToolTip.Tip="Theme: Hell"
                       IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.Light}}">
            <PathIcon Data="{StaticResource IconLight}" Width="16" Height="16" />
          </RadioButton>
          <RadioButton Classes="segment" GroupName="theme" ToolTip.Tip="Theme: Dunkel"
                       IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static profiles:ThemePreference.Dark}}">
            <PathIcon Data="{StaticResource IconDark}" Width="16" Height="16" />
          </RadioButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Fußzeile: Status und Aktionen -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding BlockingText}" Margin="6,0,0,0" FontWeight="SemiBold"
                   Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="3" Content="Letzte Umbenennung widerrufen" Command="{Binding UndoRenameCommand}" Margin="0,0,8,0"
                ToolTip.Tip="Gibt den zuletzt umbenannten Dateien ihre vorherigen Namen zurück" />
        <Button Grid.Column="4" Content="Änderungen verwerfen" Command="{Binding DiscardCommand}" Margin="0,0,8,0"
                ToolTip.Tip="Leert die Kette; die Dateiliste bleibt erhalten" />
        <Button Grid.Column="5" Content="Umbenennen" Classes="accent" Command="{Binding RenameCommand}" />
      </Grid>
    </Border>

    <!-- Zweigeteilter Inhalt -->
    <Grid RowDefinitions="*,Auto,*">
      <!-- Obere Hälfte: Einstellungen -->
      <Grid ColumnDefinitions="270,*">
        <Border Classes="pane" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="VERFAHREN" />
            <ListBox Classes="plain" ItemsSource="{Binding RuleKinds}" SelectedItem="{Binding SelectedRuleKind}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleKindItem">
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,6">
                    <Border Classes="ruleBar" controls:RuleColor.Kind="{Binding Kind}" />
                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1">
          <StackPanel Margin="16,12" Spacing="12" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="ruleBar" controls:RuleColor.Kind="{Binding Editor.Kind}" MinHeight="20" />
              <TextBlock Text="{Binding Editor.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <ContentControl Content="{Binding Editor}" />
            <Grid ColumnDefinitions="190,*" IsVisible="{Binding Editor.HasExample}">
              <TextBlock Text="Beispiel" VerticalAlignment="Center" />
              <Border Grid.Column="1" HorizontalAlignment="Left" Padding="10,5" CornerRadius="4" BorderThickness="1"
                      Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                <TextBlock Classes="mono" Text="{Binding Editor.Example}" />
              </Border>
            </Grid>
            <TextBlock Classes="error" Text="{Binding Editor.ValidationMessage}" IsVisible="{Binding Editor.HasValidationMessage}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="Zur Kette hinzufügen" Command="{Binding AddToChainCommand}" />
              <Button Content="Auf Standardwerte zurücksetzen" Command="{Binding ResetEditorCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" IsVisible="{Binding IsEditingChainItem}"
                       Text="Sie bearbeiten den gewählten Ketteneintrag – Änderungen wirken sofort auf die Vorschau. „Zur Kette hinzufügen“ legt eine Kopie an." />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" Background="{DynamicResource AppBorderBrush}" />

      <!-- Untere Hälfte: Kette und Vorschau -->
      <Grid Grid.Row="2" ColumnDefinitions="270,*">
        <Border Classes="pane" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="ANGEWANDTE VERFAHREN" />
            <TextBlock DockPanel.Dock="Top" Classes="hint" Text="▾ Kette (Reihenfolge per Drag &amp; Drop)" Margin="2,0,0,6" />
            <ListBox x:Name="ChainList" Classes="plain" ItemsSource="{Binding Chain}" SelectedItem="{Binding SelectedChainItem}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChainItemViewModel">
                  <Border Classes="chainItem" Classes.error="{Binding HasError}" BorderThickness="1" BorderBrush="Transparent"
                          CornerRadius="4" Padding="4,4" ToolTip.Tip="{Binding Error}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                      <TextBlock Classes="dragHandle" Text="⋮⋮" Cursor="SizeNorthSouth" VerticalAlignment="Center"
                                 Foreground="{DynamicResource MutedTextBrush}" Padding="4,0" ToolTip.Tip="Ziehen zum Verschieben" />
                      <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}" MinWidth="0" Margin="2,0,4,0" ToolTip.Tip="Verfahren anwenden" />
                      <Border Grid.Column="2" Classes="ruleBar" controls:RuleColor.Kind="{Binding Kind}" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="3" Text="{Binding DisplayName}" TextWrapping="Wrap" VerticalAlignment="Center"
                                 Classes.strike="{Binding !IsEnabled}" />
                      <Button Grid.Column="4" Content="✕" Padding="6,2" Background="Transparent" ToolTip.Tip="Entfernen"
                              Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).RemoveChainItemCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <Border Grid.Column="1" Classes="pane">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
              <TextBlock Classes="paneTitle" Text="VORSCHAU" />
              <CheckBox Grid.Column="1" Content="Dateierweiterung ignorieren" IsChecked="{Binding IgnoreExtension}" />
            </Grid>
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
              <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                      CornerRadius="4" Padding="8" Background="{DynamicResource DropHintBrush}">
                <TextBlock Text="Dateien oder Ordner hierher ziehen" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
              </Border>
              <Button Grid.Column="1" Content="Liste leeren" Command="{Binding ClearFilesCommand}" Margin="8,0,0,0"
                      VerticalAlignment="Stretch" VerticalContentAlignment="Center" />
            </Grid>
            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackgroundBrush}" Padding="8,6"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="32,28,*,*">
                    <CheckBox IsChecked="{Binding AreAllSelected}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                              ToolTip.Tip="Alle bzw. keine Dateien auswählen" />
                    <TextBlock Grid.Column="2" Classes="paneTitle" Margin="0" Text="AKTUELLER NAME" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="paneTitle" Margin="0" Text="NEUER NAME" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <ListBox Classes="preview" ItemsSource="{Binding PreviewRows}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PreviewRowViewModel">
                      <Border Classes="previewRow" Classes.conflict="{Binding HasConflict}" Classes.unselected="{Binding !IsSelected}" Padding="8,3">
                        <Grid ColumnDefinitions="32,28,*,*">
                          <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                    ToolTip.Tip="Datei umbenennen" />
                          <TextBlock Grid.Column="1" Text="⚠" Foreground="{DynamicResource WarnBrush}" IsVisible="{Binding HasHint}"
                                     ToolTip.Tip="{Binding IssueText}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="⛔" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasConflict}"
                                     ToolTip.Tip="{Binding IssueText}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="mono name" Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" Margin="0,0,12,0" />
                          <controls:HighlightedTextBlock Grid.Column="3" Classes="mono name" Spans="{Binding Spans}" TextTrimming="CharacterEllipsis"
                                                         VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
