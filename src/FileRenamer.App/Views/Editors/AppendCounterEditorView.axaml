<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="using:FileRenamer.App.ViewModels.Editors"
             xmlns:rules="using:FileRenamer.Core.Rules"
             x:Class="FileRenamer.App.Views.Editors.AppendCounterEditorView"
             x:DataType="ed:AppendCounterEditorViewModel">
  <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="Position" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal">
      <RadioButton Classes="segment" GroupName="counterPosition" Content="Vor dem Namen"
                   IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:AffixPosition.BeforeName}}" />
      <RadioButton Classes="segment" GroupName="counterPosition" Content="Nach dem Namen"
                   IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:AffixPosition.AfterName}}" />
    </StackPanel>

    <TextBlock Grid.Row="1" Text="Startwert" VerticalAlignment="Center" />
    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Start}" Increment="1" FormatString="0" Width="140" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="2" Text="Schrittweite" VerticalAlignment="Center" />
    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Step}" Increment="1" FormatString="0" Width="140" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="3" Text="Stellen (führende Nullen)" VerticalAlignment="Center" />
    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Digits}" Minimum="1" Maximum="18" Increment="1" FormatString="0" Width="140" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="4" Text="Trennzeichen" VerticalAlignment="Center" />
    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Separator}" Width="70" HorizontalAlignment="Left" />

    <TextBlock Grid.Row="5" Text="Sortieren nach" VerticalAlignment="Center" />
    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="10">
      <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="170">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="ed:SortOption">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Orientation="Horizontal">
        <RadioButton Classes="segment" GroupName="counterOrder" Content="Aufsteigend" IsChecked="{Binding !Descending}" />
        <RadioButton Classes="segment" GroupName="counterOrder" Content="Absteigend" IsChecked="{Binding Descending}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
