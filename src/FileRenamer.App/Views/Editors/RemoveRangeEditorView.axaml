<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FileRenamer.App.Localization"
             xmlns:ed="using:FileRenamer.App.ViewModels.Editors"
             xmlns:rules="using:FileRenamer.Core.Rules"
             x:Class="FileRenamer.App.Views.Editors.RemoveRangeEditorView"
             x:DataType="ed:RemoveRangeEditorViewModel">
  <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9" MaxWidth="720" HorizontalAlignment="Left">
    <TextBlock Text="{loc:T Remove.Mode}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal">
      <RadioButton Classes="segment" GroupName="removeMode" Content="{loc:T Remove.Cut}"
                   IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:RemoveMode.Cut}}" />
      <RadioButton Classes="segment" GroupName="removeMode" Content="{loc:T Remove.Truncate}"
                   IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:RemoveMode.Truncate}}" />
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{loc:T Remove.From}" VerticalAlignment="Center" IsVisible="{Binding IsCutMode}" />
    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsCutMode}">
      <NumericUpDown Value="{Binding Position}" Minimum="0" Increment="1" FormatString="0" Width="140" />
      <CheckBox Content="{loc:T Common.FromEnd}" IsChecked="{Binding FromEnd}" />
    </StackPanel>

    <TextBlock Grid.Row="2" Text="{loc:T Remove.Count}" VerticalAlignment="Center" IsVisible="{Binding IsCutMode}" />
    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Count}" Minimum="1" Increment="1" FormatString="0" Width="140"
                   HorizontalAlignment="Left" IsVisible="{Binding IsCutMode}" />

    <TextBlock Grid.Row="3" Text="{loc:T Remove.MaxLength}" VerticalAlignment="Center" IsVisible="{Binding !IsCutMode}" />
    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MaxLength}" Minimum="1" Increment="1" FormatString="0" Width="140"
                   HorizontalAlignment="Left" IsVisible="{Binding !IsCutMode}" />

    <TextBlock Grid.Row="4" Grid.Column="1" Classes="hint"
               Text="{loc:T Remove.Hint}" />
  </Grid>
</UserControl>
