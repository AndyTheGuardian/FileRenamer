<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FileRenamer.App.Localization"
             xmlns:ed="using:FileRenamer.App.ViewModels.Editors"
             xmlns:rules="using:FileRenamer.Core.Rules"
             x:Class="FileRenamer.App.Views.Editors.ReplaceTextEditorView"
             x:DataType="ed:ReplaceTextEditorViewModel">
  <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="9" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="{loc:T Replace.Search}" VerticalAlignment="Center" />
    <TextBox Grid.Column="1" Text="{Binding SearchText}" />

    <TextBlock Grid.Row="1" Text="{loc:T Replace.With}" VerticalAlignment="Center" />
    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Replacement}" />

    <TextBlock Grid.Row="2" Text="{loc:T Replace.Matches}" VerticalAlignment="Center" />
    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
      <RadioButton Classes="segment" GroupName="occurrence" Content="{loc:T Replace.First}"
                   IsChecked="{Binding Occurrence, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:MatchOccurrence.First}}" />
      <RadioButton Classes="segment" GroupName="occurrence" Content="{loc:T Replace.Last}"
                   IsChecked="{Binding Occurrence, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:MatchOccurrence.Last}}" />
      <RadioButton Classes="segment" GroupName="occurrence" Content="{loc:T Replace.All}"
                   IsChecked="{Binding Occurrence, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:MatchOccurrence.All}}" />
    </StackPanel>

    <CheckBox Grid.Row="3" Grid.Column="1" Content="{loc:T Replace.Regex}" IsChecked="{Binding UseRegex}" />
    <TextBlock Grid.Row="4" Grid.Column="1" Classes="hint" Text="{loc:T Replace.Hint}" />
  </Grid>
</UserControl>
