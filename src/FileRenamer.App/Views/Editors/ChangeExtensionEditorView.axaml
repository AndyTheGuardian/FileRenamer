<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FileRenamer.App.Localization"
             xmlns:ed="using:FileRenamer.App.ViewModels.Editors"
             xmlns:rules="using:FileRenamer.Core.Rules"
             x:Class="FileRenamer.App.Views.Editors.ChangeExtensionEditorView"
             x:DataType="ed:ChangeExtensionEditorViewModel">
  <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="9" MaxWidth="720" HorizontalAlignment="Left">
    <TextBlock Text="{loc:T Ext.Only}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
      <TextBox Text="{Binding OnlyExtension}" Width="110" />
      <TextBlock Classes="hint" Text="{loc:T Ext.OnlyHint}" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{loc:T Ext.New}" VerticalAlignment="Center" />
    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
      <TextBox Text="{Binding NewExtension}" Width="110" />
      <TextBlock Classes="hint" Text="{loc:T Ext.NewHint}" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Grid.Row="2" Text="{loc:T Ext.Casing}" VerticalAlignment="Center" />
    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
      <RadioButton Classes="segment" GroupName="extCasing" Content="{loc:T Ext.Unchanged}"
                   IsChecked="{Binding Casing, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:ExtensionCasing.Unchanged}}" />
      <RadioButton Classes="segment" GroupName="extCasing" Content="{loc:T Ext.Lower}"
                   IsChecked="{Binding Casing, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:ExtensionCasing.Lower}}" />
      <RadioButton Classes="segment" GroupName="extCasing" Content="{loc:T Ext.Upper}"
                   IsChecked="{Binding Casing, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static rules:ExtensionCasing.Upper}}" />
    </StackPanel>

    <TextBlock Grid.Row="3" Grid.Column="1" Classes="hint"
               Text="{loc:T Ext.Hint}" />
  </Grid>
</UserControl>
