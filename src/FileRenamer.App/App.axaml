<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:FileRenamer.App.Converters"
             x:Class="FileRenamer.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Einheitliche Höhe aller Bedienelemente (Schaltflächen, Text-, Zahlen- und Auswahlfelder, Umschalter);
           so hoch wie Fluent-Schaltflächen und -Textfelder mit der App-Schrift (E160) -->
      <x:Double x:Key="ControlHeight">33</x:Double>
      <converters:EnumEqualsConverter x:Key="EnumEquals" />
      <converters:HexToBrushConverter x:Key="HexToBrush" />

      <!-- Werden vom ThemeService passend zur Akzentfarbe überschrieben (E80, E85) -->
      <SolidColorBrush x:Key="AccentForegroundBrush" Color="#F4F7FC" />
      <SolidColorBrush x:Key="AccentOutlineBrush" Color="Transparent" />
      <SolidColorBrush x:Key="AccentSegmentBorderBrush" Color="#2F6FDF" />

      <!-- Icons für die Theme-Auswahl: Monitor = System, Sonne = Hell, Mond = Dunkel -->
      <StreamGeometry x:Key="IconSystem">M4,5 L20,5 C20.8,5 21.5,5.7 21.5,6.5 L21.5,15.5 C21.5,16.3 20.8,17 20,17 L4,17 C3.2,17 2.5,16.3 2.5,15.5 L2.5,6.5 C2.5,5.7 3.2,5 4,5 Z M4,6.5 L4,15.5 L20,15.5 L20,6.5 Z M8,19.5 L16,19.5 L16,21 L8,21 Z M11.25,17 L12.75,17 L12.75,19.5 L11.25,19.5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconLight">M12,7.5 A4.5,4.5 0 1 1 11.99,7.5 Z M11.25,1.5 L12.75,1.5 L12.75,4.5 L11.25,4.5 Z M11.25,19.5 L12.75,19.5 L12.75,22.5 L11.25,22.5 Z M1.5,11.25 L4.5,11.25 L4.5,12.75 L1.5,12.75 Z M19.5,11.25 L22.5,11.25 L22.5,12.75 L19.5,12.75 Z M4.4,5.5 L5.5,4.4 L7.6,6.5 L6.5,7.6 Z M16.4,17.5 L17.5,16.4 L19.6,18.5 L18.5,19.6 Z M4.4,18.5 L6.5,16.4 L7.6,17.5 L5.5,19.6 Z M16.4,6.5 L18.5,4.4 L19.6,5.5 L17.5,7.6 Z</StreamGeometry>
      <!-- Bereichsumschalter (E119): „T“ mit Pfeil = Umbenennen, Etikett = Tags -->
      <StreamGeometry x:Key="IconRename">M3,4 L16,4 L16,7.5 L14.5,7.5 L14.5,5.5 L10.25,5.5 L10.25,18.5 L12.5,18.5 L12.5,20 L6.5,20 L6.5,18.5 L8.75,18.5 L8.75,5.5 L4.5,5.5 L4.5,7.5 L3,7.5 Z M14,14.25 L19.4,14.25 L17.2,12.05 L18.25,11 L22.25,15 L18.25,19 L17.2,17.95 L19.4,15.75 L14,15.75 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTags">F1 M2,3 L11.5,3 L22,13.5 L13.5,22 L2,10.5 Z M3.5,4.5 L3.5,9.9 L13.5,19.9 L19.9,13.5 L10.9,4.5 Z M7,6.25 A1.75,1.75 0 1 0 7.01,6.25 Z</StreamGeometry>
      <!-- Zahnrad der Einstellungen (wie PDF Utopia, E156) -->
      <StreamGeometry x:Key="IconSettings">M19.2 10.2 L21.5 10.6 L21.5 13.4 L19.2 13.8 L18.4 15.8 L19.7 17.8 L17.8 19.7 L15.8 18.4 L13.8 19.2 L13.4 21.5 L10.6 21.5 L10.2 19.2 L8.2 18.4 L6.2 19.7 L4.3 17.8 L5.6 15.8 L4.8 13.8 L2.5 13.4 L2.5 10.6 L4.8 10.2 L5.6 8.2 L4.3 6.2 L6.2 4.3 L8.2 5.6 L10.2 4.8 L10.6 2.5 L13.4 2.5 L13.8 4.8 L15.8 5.6 L17.8 4.3 L19.7 6.2 L18.4 8.2z M15 12a3 3 0 1 1-6 0a3 3 0 1 1 6 0z</StreamGeometry>
      <StreamGeometry x:Key="IconDark">M12.5,3 A9,9 0 1 0 21,13.5 A7,7 0 1 1 12.5,3 Z</StreamGeometry>

      <ResourceDictionary.ThemeDictionaries>
        <!-- Helles Theme ohne reines Weiß (E30) -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#E8EBEF" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F9FAFB" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#CDD2DA" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#646C7C" />
          <SolidColorBrush x:Key="SelectionBrush" Color="#D3DEF3" />
          <SolidColorBrush x:Key="DangerBrush" Color="#C93434" />
          <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#F6E1E1" />
          <SolidColorBrush x:Key="WarnBrush" Color="#B7791F" />
          <SolidColorBrush x:Key="DropHintBrush" Color="#E1E7F2" />
          <!-- Dialoge heben sich vom Hauptfenster ab (V22, E149): Fläche etwas dunkler, Rahmen;
               das Hauptfenster wird abgedunkelt -->
          <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#E6E9EE" />
          <SolidColorBrush x:Key="DialogBorderBrush" Color="#AEB6C2" />
          <SolidColorBrush x:Key="DialogShadeBrush" Color="#59101318" />

          <SolidColorBrush x:Key="RuleColor.ReplaceText" Color="#2F6FDF" />
          <SolidColorBrush x:Key="RuleColor.AppendDate" Color="#1F9D55" />
          <SolidColorBrush x:Key="RuleColor.AppendCounter" Color="#E8740C" />
          <SolidColorBrush x:Key="RuleColor.ShiftDigitRange" Color="#8B4FD6" />
          <SolidColorBrush x:Key="RuleColor.InsertText" Color="#D63C86" />
          <SolidColorBrush x:Key="RuleHighlight.ReplaceText" Color="#552F6FDF" />
          <SolidColorBrush x:Key="RuleHighlight.AppendDate" Color="#551F9D55" />
          <SolidColorBrush x:Key="RuleHighlight.AppendCounter" Color="#55E8740C" />
          <SolidColorBrush x:Key="RuleHighlight.ShiftDigitRange" Color="#558B4FD6" />
          <SolidColorBrush x:Key="RuleHighlight.InsertText" Color="#55D63C86" />
          <SolidColorBrush x:Key="RuleColor.ChangeCase" Color="#0E9AA7" />
          <SolidColorBrush x:Key="RuleColor.Template" Color="#C99A06" />
          <SolidColorBrush x:Key="RuleColor.CleanCharacters" Color="#64748B" />
          <SolidColorBrush x:Key="RuleColor.RemoveRange" Color="#A0522D" />
          <SolidColorBrush x:Key="RuleColor.ChangeExtension" Color="#7C8B1A" />
          <SolidColorBrush x:Key="RuleColor.InsertFolder" Color="#4338CA" />
          <SolidColorBrush x:Key="RuleHighlight.ChangeCase" Color="#550E9AA7" />
          <SolidColorBrush x:Key="RuleHighlight.Template" Color="#55C99A06" />
          <SolidColorBrush x:Key="RuleHighlight.CleanCharacters" Color="#5564748B" />
          <SolidColorBrush x:Key="RuleHighlight.RemoveRange" Color="#55A0522D" />
          <SolidColorBrush x:Key="RuleHighlight.ChangeExtension" Color="#557C8B1A" />
          <SolidColorBrush x:Key="RuleHighlight.InsertFolder" Color="#554338CA" />

          <!-- Fluent-Eingabefelder ebenfalls ohne reines Weiß -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#F9FAFB" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F4F6F8" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FBFCFD" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#F9FAFB" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#F4F6F8" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F3F4F6" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F3F4F6" />
          <!-- Einheitliche 1-px-Rahmen wie im Mockup: Text-/Auswahlfelder und Schaltflächen wie die Segmente (E142) -->
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#CDD2DA" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#CDD2DA" />
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#CDD2DA" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#CDD2DA" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#CDD2DA" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#CDD2DA" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#CDD2DA" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CDD2DA" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#CDD2DA" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#CDD2DA" />
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#CDD2DA" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1F27" />
          <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#222731" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#171A21" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#353C4A" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#97A0B0" />
          <SolidColorBrush x:Key="SelectionBrush" Color="#2D3B57" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F06A6A" />
          <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#3A2124" />
          <SolidColorBrush x:Key="WarnBrush" Color="#E0A94A" />
          <SolidColorBrush x:Key="DropHintBrush" Color="#2A3140" />
          <!-- Dialoge heben sich vom Hauptfenster ab (V22, E149): Fläche etwas heller, Rahmen;
               das Hauptfenster wird abgedunkelt -->
          <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#272C36" />
          <SolidColorBrush x:Key="DialogBorderBrush" Color="#4A5263" />
          <SolidColorBrush x:Key="DialogShadeBrush" Color="#8C05070A" />

          <SolidColorBrush x:Key="RuleColor.ReplaceText" Color="#5B8FF0" />
          <SolidColorBrush x:Key="RuleColor.AppendDate" Color="#3CC47A" />
          <SolidColorBrush x:Key="RuleColor.AppendCounter" Color="#F39A4A" />
          <SolidColorBrush x:Key="RuleColor.ShiftDigitRange" Color="#A982EC" />
          <SolidColorBrush x:Key="RuleColor.InsertText" Color="#EC6AA8" />
          <SolidColorBrush x:Key="RuleHighlight.ReplaceText" Color="#665B8FF0" />
          <SolidColorBrush x:Key="RuleHighlight.AppendDate" Color="#663CC47A" />
          <SolidColorBrush x:Key="RuleHighlight.AppendCounter" Color="#66F39A4A" />
          <SolidColorBrush x:Key="RuleHighlight.ShiftDigitRange" Color="#66A982EC" />
          <SolidColorBrush x:Key="RuleHighlight.InsertText" Color="#66EC6AA8" />
          <SolidColorBrush x:Key="RuleColor.ChangeCase" Color="#3CC8D4" />
          <SolidColorBrush x:Key="RuleColor.Template" Color="#E8BF3A" />
          <SolidColorBrush x:Key="RuleColor.CleanCharacters" Color="#94A3B8" />
          <SolidColorBrush x:Key="RuleColor.RemoveRange" Color="#D08A5C" />
          <SolidColorBrush x:Key="RuleColor.ChangeExtension" Color="#B3C447" />
          <SolidColorBrush x:Key="RuleColor.InsertFolder" Color="#8B85F0" />
          <SolidColorBrush x:Key="RuleHighlight.ChangeCase" Color="#663CC8D4" />
          <SolidColorBrush x:Key="RuleHighlight.Template" Color="#66E8BF3A" />
          <SolidColorBrush x:Key="RuleHighlight.CleanCharacters" Color="#6694A3B8" />
          <SolidColorBrush x:Key="RuleHighlight.RemoveRange" Color="#66D08A5C" />
          <SolidColorBrush x:Key="RuleHighlight.ChangeExtension" Color="#66B3C447" />
          <SolidColorBrush x:Key="RuleHighlight.InsertFolder" Color="#668B85F0" />

          <!-- Einheitliche 1-px-Rahmen wie im Mockup: Text-/Auswahlfelder und Schaltflächen wie die Segmente (E142) -->
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#353C4A" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#353C4A" />
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#353C4A" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#353C4A" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#353C4A" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#353C4A" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#353C4A" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#353C4A" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#353C4A" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#353C4A" />
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#353C4A" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Farbbalken der Verfahren (Klasse wird über RuleColor.Kind gesetzt) -->
    <Style Selector="Border.ruleBar">
      <Setter Property="Width" Value="4" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="MinHeight" Value="16" />
    </Style>
    <Style Selector="Border.ruleBar.kind-ReplaceText"><Setter Property="Background" Value="{DynamicResource RuleColor.ReplaceText}" /></Style>
    <Style Selector="Border.ruleBar.kind-AppendDate"><Setter Property="Background" Value="{DynamicResource RuleColor.AppendDate}" /></Style>
    <Style Selector="Border.ruleBar.kind-AppendCounter"><Setter Property="Background" Value="{DynamicResource RuleColor.AppendCounter}" /></Style>
    <Style Selector="Border.ruleBar.kind-ShiftDigitRange"><Setter Property="Background" Value="{DynamicResource RuleColor.ShiftDigitRange}" /></Style>
    <Style Selector="Border.ruleBar.kind-InsertText"><Setter Property="Background" Value="{DynamicResource RuleColor.InsertText}" /></Style>
    <Style Selector="Border.ruleBar.kind-ChangeCase"><Setter Property="Background" Value="{DynamicResource RuleColor.ChangeCase}" /></Style>
    <Style Selector="Border.ruleBar.kind-Template"><Setter Property="Background" Value="{DynamicResource RuleColor.Template}" /></Style>
    <Style Selector="Border.ruleBar.kind-CleanCharacters"><Setter Property="Background" Value="{DynamicResource RuleColor.CleanCharacters}" /></Style>
    <Style Selector="Border.ruleBar.kind-RemoveRange"><Setter Property="Background" Value="{DynamicResource RuleColor.RemoveRange}" /></Style>
    <Style Selector="Border.ruleBar.kind-ChangeExtension"><Setter Property="Background" Value="{DynamicResource RuleColor.ChangeExtension}" /></Style>
    <Style Selector="Border.ruleBar.kind-InsertFolder"><Setter Property="Background" Value="{DynamicResource RuleColor.InsertFolder}" /></Style>

    <!-- Farben der Funktionen im Bereich „Tags“ (Klasse über TagColor.Function, Farben wie im Mockup v13) -->
    <Style Selector="Border.ruleBar.fn-Edit"><Setter Property="Background" Value="{DynamicResource RuleColor.ReplaceText}" /></Style>
    <Style Selector="Border.ruleBar.fn-FromFileName"><Setter Property="Background" Value="{DynamicResource RuleColor.Template}" /></Style>
    <Style Selector="Border.ruleBar.fn-TrackNumbers"><Setter Property="Background" Value="{DynamicResource RuleColor.AppendCounter}" /></Style>
    <Style Selector="Border.ruleBar.fn-Cover"><Setter Property="Background" Value="{DynamicResource RuleColor.AppendDate}" /></Style>
    <Style Selector="Border.ruleBar.fn-Lyrics"><Setter Property="Background" Value="{DynamicResource RuleColor.InsertText}" /></Style>
    <Style Selector="Border.tagCell"><Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="1,0" /><Setter Property="BorderThickness" Value="0,0,0,2" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <Style Selector="Border.tagCell.fn-Edit"><Setter Property="Background" Value="{DynamicResource RuleHighlight.ReplaceText}" /><Setter Property="BorderBrush" Value="{DynamicResource RuleColor.ReplaceText}" /></Style>
    <Style Selector="Border.tagCell.fn-FromFileName"><Setter Property="Background" Value="{DynamicResource RuleHighlight.Template}" /><Setter Property="BorderBrush" Value="{DynamicResource RuleColor.Template}" /></Style>
    <Style Selector="Border.tagCell.fn-TrackNumbers"><Setter Property="Background" Value="{DynamicResource RuleHighlight.AppendCounter}" /><Setter Property="BorderBrush" Value="{DynamicResource RuleColor.AppendCounter}" /></Style>
    <Style Selector="Border.tagCell.fn-Cover"><Setter Property="Background" Value="{DynamicResource RuleHighlight.AppendDate}" /><Setter Property="BorderBrush" Value="{DynamicResource RuleColor.AppendDate}" /></Style>
    <Style Selector="Border.tagCell.fn-Lyrics"><Setter Property="Background" Value="{DynamicResource RuleHighlight.InsertText}" /><Setter Property="BorderBrush" Value="{DynamicResource RuleColor.InsertText}" /></Style>

    <!-- Abschnittsüberschriften -->
    <Style Selector="TextBlock.paneTitle">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Segmentierte Auswahl aus RadioButtons -->
    <!-- Markierter Text: lesbare Schrift auf der Akzentfarbe, auch bei hellen Akzentfarben (E144) -->
    <Style Selector="TextBox">
      <!-- Auch mit Monospace-Schrift so hoch wie die übrigen Bedienelemente (E160) -->
      <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColor}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextSelectionForegroundBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColor}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextSelectionForegroundBrush}" />
    </Style>
    <Style Selector="RadioButton.segment">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="segmentBorder" Background="{DynamicResource InputBackgroundBrush}"
                  BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="12,0"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Margin" Value="0,0,-1,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <!-- Gleiche Höhe mit und ohne Beschriftung (E160) -->
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    </Style>
    <!-- Außenkanten der Gruppe so rund wie Buttons und Textfelder (Fluent: ControlCornerRadius = 4, E95) -->
    <Style Selector="RadioButton.segment:nth-child(1)">
      <Setter Property="CornerRadius" Value="4,0,0,4" />
    </Style>
    <Style Selector="RadioButton.segment:nth-last-child(1)">
      <Setter Property="CornerRadius" Value="0,4,4,0" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#segmentBorder">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#segmentBorder">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <!-- Oben zeichnen, damit der rechte Rahmen nicht vom überlappenden Nachbarn verdeckt wird (E101) -->
      <Setter Property="ZIndex" Value="1" />
    </Style>
    <!-- Rahmen bei zu geringem Kontrast der Akzentfarbe (E85) -->
    <Style Selector="RadioButton.segment:checked /template/ Border#segmentBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSegmentBorderBrush}" />
    </Style>
    <!-- Dateilisten (Umbenennen und Tags) einheitlich (E150, E152): kleine Checkbox für niedrige Zeilen,
         Spaltenkopf mit Abschneiden für horizontales Scrollen, Hinweis in der leeren Liste, kleine Schaltfläche
         in der Titelzeile -->
    <Style Selector="CheckBox.fileCheck">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox.fileCheck /template/ Border#NormalRectangle">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <!-- Der Fluent-Inhalt hat feste 32 px Höhe; für niedrige Zeilen auf 16 px -->
    <Style Selector="CheckBox.fileCheck /template/ Grid#RootGrid > Grid">
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="CheckBox.fileCheck /template/ Viewbox">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="Border.listHeader">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.emptyHint">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="16" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.paneAction">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Auswahlfelder so hoch wie Schaltflächen und Textfelder (E160) -->
    <Style Selector="ComboBox, NumericUpDown">
      <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    </Style>
  </Application.Styles>
</Application>
